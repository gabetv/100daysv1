# Base Neon (Postgres) — utilisée par les fonctions Vercel ET par le serveur de jeu
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# URL publique du serveur de jeu WebSocket (à mettre UNIQUEMENT sur Vercel)
# Exemple : wss://iles-100-jours.onrender.com
GAME_WS_URL=

# Port du serveur de jeu (fourni automatiquement par Render/Railway/Fly)
PORT=3000
