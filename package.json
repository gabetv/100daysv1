{
  "name": "save-human-online",
  "version": "1.0.0",
  "description": "Multiplayer version of the Save Human game.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "generate:ui": "node scripts/generate_ui_assets.js",
    "generate:sheets": "node scripts/generate_ui_sheets.js",
    "generate:mobile-hud": "node scripts/generate_mobile_hud_sheet.js",
    "generate:sprites": "node scripts/generate_spritesheets.js",
    "generate:assets": "npm run generate:ui && npm run generate:sheets && npm run generate:mobile-hud && npm run generate:nav && npm run generate:sprites",
    "test:resolution": "node scripts/test-resolution.mjs",
    "generate:nav": "node scripts/generate_navigation_sheet.js",
    "harmonize:palette": "node scripts/harmonize_palette.mjs",
    "test:navigation": "node scripts/test-navigation.mjs",
    "test": "npm run test:resolution && npm run test:navigation && npm run test:layout && npm run test:item-actions && npm run test:character-anim",
    "test:layout": "node scripts/test-scene-layout.mjs",
    "test:item-actions": "node scripts/test-item-actions.mjs",
    "test:character-anim": "node scripts/test-character-anim.mjs",
    "test:combat": "node scripts/test-combat.mjs",
    "test:npc-ai": "node scripts/test-npc-ai.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "express": "^4.22.3",
    "pg": "^8.13.1",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": "22.x"
  }
}
